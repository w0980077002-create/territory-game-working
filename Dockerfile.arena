FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=8787 ARENA_WEB_ROOT=/app/web ARENA_DB=/data/arena.sqlite
WORKDIR /app
COPY --chown=node:node .tmp/arena/server.mjs ./server.mjs
COPY --chown=node:node .tmp/arena/web ./web
RUN mkdir /data && chown node:node /data
USER node
EXPOSE 8787
VOLUME ["/data"]
CMD ["node", "server.mjs"]
