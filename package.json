{
  "name": "viking-vs-rome-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "arena:build": "VITE_ARENA_ENABLED=1 vite build --outDir .tmp/arena/web && esbuild server/arena/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=.tmp/arena/server.mjs",
    "arena:local": "ARENA_LOCAL=1 node .tmp/arena/server.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src/ui/carnival src/ui/App.tsx src/ui/DarkPanels.tsx src/ui/SagaUI.tsx src/ui/HarborScene.tsx src/ui/OnlineArena.tsx src/ui/CommunityPanel.tsx src/community src/arena server/arena src/core/store.ts tests/notices.test.ts tests/online-arena.test.ts",
    "test:windows": "node scripts/qa/windows.cjs",
    "test:buttons": "node scripts/qa/button-routes.cjs",
    "test:natural": "node scripts/qa/natural-start.cjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.65.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.2.0"
  }
}
